# 可选：用已有 nginx 反向代理「血压管家」，实现 HTTPS 访问（PWA/系统通知需要 HTTPS）
#
# 需要：
# 1) 路由器把 80/443 转发到 192.0.2.10；
# 2) DNS（DDNS 域名）解析到家里公网 IP；
# 3) 把下面 server 块放到 /etc/nginx/conf.d/bp-app.conf（按需修改域名与证书路径）；
# 4) nginx -t && systemctl reload nginx。
#
# 注意：本机已有 nginx 在 80/443 上跑其他站点，请使用「新的子域名」而不是修改现有站点。

server {
    listen 80;
    server_name bp.example.com;          # 换成你的 DDNS 子域名
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name bp.example.com;          # 换成你的 DDNS 子域名

    ssl_certificate     /etc/letsencrypt/live/bp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bp.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;            # 允许上传血压计照片

    location / {
        proxy_pass http://127.0.0.1:8288;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}

# 申请证书示例（需要 80 端口可从公网访问）：
#   apt-get install -y certbot
#   certbot certonly --webroot -w /var/www/certbot -d bp.example.com
# 若 nginx 已被其他业务占用 80/443，也可以只在已有 server 中追加：
#   location ^~ /bp/ { proxy_pass http://127.0.0.1:8288/; ... }
# 注意：按路径反代需要前端支持子路径（当前版本默认部署在根路径，建议使用独立子域名）。
